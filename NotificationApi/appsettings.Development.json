{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NotificationDb;Username=;Password="
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "your_redis_password"
  },
  "SmtpMail": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "user@gmail.com",
    "Password": "",
    "FromEmail": "",
    "FromName": "",
    "SenderEmail": ""
  },
  "Telegram": {
    "BotToken": "your_telegram_bot_token",
    "ChatId": "your_telegram_chat_id",
    "AutoSetWebhook": false,
    "WebhookBaseUrl": "https://your-public-domain.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Notification API"
    }
  },
  "OpenTelemetry": {
    "Host": "otel-collector-opentelemetry-collector.devops.svc.cluster.local",
    "Port": 4317
  },
  "FluentBit": {
    "Host": "fluent-bit.devops.svc.cluster.local",
    "Port": 2020,
    "ServicePort": 24224,
    "BufferSize": 52428800, // 50MB
    "BatchSize": 1000,
    "BatchInterval": 2
  },
  "Discord": {
    "BotToken": "your_discord_bottoken",
    "ChannelId": "your_discord_channelid"
  }
}
